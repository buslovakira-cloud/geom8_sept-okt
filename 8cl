/* ===== Приложение ===== */
(function(){
const $=s=>document.querySelector(s);
const topicsEl=$('#topics'),kindsEl=$('#kinds'),scene=$('#scene'),posEl=$('#pos'),cntEl=$('#cnt'),barI=$('#bar i');
const prevB=$('#prev'),nextB=$('#next'),againB=$('#again'),knowB=$('#know'),shufB=$('#shuf'),resetB=$('#reset');
let topic='all',kind='all',deck=[],pos=0,back=false,shuffled=false,status={},rank={};
try{status=JSON.parse(localStorage.getItem('kv8-status')||'{}')||{}}catch(e){status={}}
const save=()=>{try{localStorage.setItem('kv8-status',JSON.stringify(status))}catch(e){}};
const tOf=id=>TOPICS.find(t=>t.id===id);

/* --- фильтры --- */
topicsEl.innerHTML=['<button class="chip" data-t="all" aria-pressed="true">Все</button>']
  .concat(TOPICS.map(t=>`<button class="chip" style="--c:var(${t.c})" data-t="${t.id}" aria-pressed="false">${t.name}</button>`)).join('');
CARDS.forEach(c=>{rank[c.id]=Math.random()});

function inTopic(c){return topic==='all'||c.t===topic}
function computeDeck(keepId){
  deck=CARDS.filter(c=>inTopic(c)&&(kind==='all'||(kind==='theory'&&c.k!=='task')||(kind==='task'&&c.k==='task')||(kind==='again'&&status[c.id]==='a')));
  if(shuffled)deck.sort((a,b)=>rank[a.id]-rank[b.id]);
  if(keepId){const i=deck.findIndex(c=>c.id===keepId);if(i>=0)pos=i}
  if(pos>=deck.length)pos=Math.max(0,deck.length-1);
}
function renderKinds(){
  const again=CARDS.filter(c=>inTopic(c)&&status[c.id]==='a').length;
  const K=[['all','Все'],['theory','Теория'],['task','Задачи'],['again','Повторить ('+again+')']];
  kindsEl.innerHTML=K.map(k=>`<button data-k="${k[0]}" aria-pressed="${kind===k[0]}">${k[1]}</button>`).join('');
}

/* --- карточка --- */
function answerHTML(a){return Array.isArray(a)?'<ul>'+a.map(x=>'<li>'+x+'</li>').join('')+'</ul>':a}
function cardHTML(c){
  const T=tOf(c.t),st=status[c.id];
  const stb=st==='k'?'<span class="st k">✓ знаю</span>':st==='a'?'<span class="st a">↺ повторить</span>':'';
  const head=`<div class="fh"><span class="tag">${T.name}</span><span class="kind">${KINDS[c.k]}${stb}</span></div>`;
  const front=c.fq?fig(c.fq[0],c.fq[1]):(c.f?fig(c.f[0],''):'');
  const backFig=c.f?fig(c.f[0],c.f[1]):'';
  return `<div class="card${back?' is-back':''}" id="card" style="--c:var(${T.c})" tabindex="0" role="button" aria-label="Карточка. Нажми, чтобы перевернуть">
    <div class="flip">
      <div class="face front"${back?' inert':''}>${head}
        <p class="q">${c.q}</p>
        <div class="fig">${front}</div>
        <p class="tip">Нажми на карточку, чтобы увидеть ответ</p>
      </div>
      <div class="face back"${back?'':' inert'}>${head}
        <p class="lab">Ответ</p>
        <div class="a">${answerHTML(c.a)}</div>
        ${backFig?`<div class="fig">${backFig}</div>`:''}
        ${c.h?`<div class="note"><small>Запоминалка</small>${c.h}</div>`:''}
      </div>
    </div>
  </div>`;
}
function setBack(v){
  back=v;
  const el=$('#card');if(!el)return;
  el.classList.toggle('is-back',v);
  const f=el.querySelector('.front'),b=el.querySelector('.back');
  f.toggleAttribute('inert',v);b.toggleAttribute('inert',!v);
}
function render(){
  const n=deck.length;
  topicsEl.querySelectorAll('.chip').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.t===topic)));
  renderKinds();
  let k=0,a=0;deck.forEach(c=>{if(status[c.id]==='k')k++;else if(status[c.id]==='a')a++});
  cntEl.innerHTML=`знаю <b>${k}</b> · повторить <b>${a}</b> · новые <b>${n-k-a}</b>`;
  const col=topic==='all'?'var(--ink)':'var(--'+topic+')';
  barI.style.background=col;
  [prevB,nextB,againB,knowB].forEach(b=>b.disabled=!n);
  if(!n){
    posEl.textContent='0 из 0';barI.style.width='0';
    scene.innerHTML=kind==='again'
      ?'<div class="empty"><b>Здесь пока пусто</b><span>Отмечай карточки кнопкой «Повторить», и они соберутся тут.</span></div>'
      :'<div class="empty"><b>Карточек нет</b><span>Выбери другую тему или тип.</span></div>';
    return;
  }
  posEl.innerHTML=`Карточка <b>${pos+1}</b> из <b>${n}</b>`;
  barI.style.width=((pos+1)/n*100)+'%';
  scene.innerHTML=cardHTML(deck[pos]);
}
function go(d){if(!deck.length)return;pos=(pos+d+deck.length)%deck.length;back=false;render()}
function mark(s){
  const c=deck[pos];if(!c)return;
  status[c.id]=s;save();
  if(kind==='again'&&s==='k'){computeDeck();back=false;render()}
  else go(1);
}
function reload(){computeDeck();back=false;render()}

topicsEl.addEventListener('click',e=>{
  const b=e.target.closest('[data-t]');if(!b)return;
  topic=b.dataset.t;pos=0;reload();
  topicsEl.scrollLeft=b.offsetLeft-topicsEl.clientWidth/2+b.offsetWidth/2;
});
kindsEl.addEventListener('click',e=>{
  const b=e.target.closest('[data-k]');if(!b)return;
  kind=b.dataset.k;pos=0;reload();
});
let swiped=0;
scene.addEventListener('click',e=>{
  if(Date.now()-swiped<450||!e.target.closest('#card'))return;
  setBack(!back);
});
scene.addEventListener('keydown',e=>{
  if(e.target.id==='card'&&(e.key===' '||e.key==='Enter')){e.preventDefault();setBack(!back)}
});
let sx=0,sy=0;
scene.addEventListener('touchstart',e=>{const t=e.touches[0];sx=t.clientX;sy=t.clientY},{passive:true});
scene.addEventListener('touchend',e=>{
  const t=e.changedTouches[0],dx=t.clientX-sx,dy=t.clientY-sy;
  if(Math.abs(dx)>60&&Math.abs(dy)<45){swiped=Date.now();go(dx<0?1:-1)}
},{passive:true});
prevB.onclick=()=>go(-1);nextB.onclick=()=>go(1);
againB.onclick=()=>mark('a');knowB.onclick=()=>mark('k');
shufB.onclick=()=>{
  shuffled=!shuffled;
  if(shuffled)CARDS.forEach(c=>{rank[c.id]=Math.random()});
  shufB.textContent=shuffled?'По порядку':'Перемешать';
  pos=0;reload();
};
let rt=0;
resetB.onclick=()=>{
  if(resetB.dataset.arm){
    clearTimeout(rt);delete resetB.dataset.arm;resetB.textContent='Сбросить отметки';
    status={};save();pos=0;reload();
  }else{
    resetB.dataset.arm='1';resetB.textContent='Нажми ещё раз, и все отметки сбросятся';
    rt=setTimeout(()=>{delete resetB.dataset.arm;resetB.textContent='Сбросить отметки'},3500);
  }
};

/* --- вкладки --- */
const TABS=['cards','tree','table'];
function showTab(n){
  TABS.forEach(t=>{
    const sel=t===n,b=$('#t-'+t);
    b.setAttribute('aria-selected',String(sel));b.tabIndex=sel?0:-1;$('#v-'+t).hidden=!sel;
  });
}
document.querySelector('.tabs').addEventListener('click',e=>{
  const b=e.target.closest('[role=tab]');if(b)showTab(b.id.slice(2));
});
document.querySelector('.tabs').addEventListener('keydown',e=>{
  const i=TABS.findIndex(t=>$('#t-'+t).getAttribute('aria-selected')==='true');
  if(e.key==='ArrowRight'||e.key==='ArrowLeft'){
    const n=TABS[(i+(e.key==='ArrowRight'?1:2))%3];showTab(n);$('#t-'+n).focus();
  }
});
document.addEventListener('keydown',e=>{
  if($('#v-cards').hidden||/INPUT|TEXTAREA/.test(e.target.tagName)||e.target.closest('.tabs'))return;
  if(e.key==='ArrowRight')go(1);
  if(e.key==='ArrowLeft')go(-1);
});

/* --- дерево --- */
(function(){
  const W=170,H=96;
  const N=[
    {id:'quad',x:95,y:4,t:'Четырёхугольник',s:['∑ углов','= 360°'],sh:'quad'},
    {id:'para',x:4,y:124,t:'Параллелограмм',s:['стороны ∥','попарно'],sh:'para'},
    {id:'trap',x:186,y:124,t:'Трапеция',s:['одна пара','сторон ∥'],sh:'trap'},
    {id:'rect',x:4,y:244,t:'Прямоугольник',s:['+ все углы','по 90°'],sh:'rect'},
    {id:'rhomb',x:186,y:244,t:'Ромб',s:['+ все','стороны равны'],sh:'rhomb'},
    {id:'sq',x:95,y:364,t:'Квадрат',s:['всё сразу:','углы 90° и','стороны равны'],sh:'sq'}
  ];
  const E=['M180 100V112H89V124','M180 100V112H271V124','M89 220V244','M89 220V232H271V244','M89 340V352H180V364','M271 340V352H180V364'];
  let s=`<svg class="t fsv" viewBox="0 0 360 466" role="group" aria-label="Семейное дерево четырёхугольников">`;
  s+=E.map(d=>`<path class="edge" d="${d}"/>`).join('');
  N.forEach(n=>{
    s+=`<g class="node" style="--c:var(--${n.id})" data-t="${n.id}" tabindex="0" role="button" aria-label="${n.t}: открыть карточки">
      <rect class="nb" x="${n.x}" y="${n.y}" width="${W}" height="${H}" rx="14"/>
      <text class="nm" x="${n.x+12}" y="${n.y+24}">${n.t}</text>
      <svg x="${n.x+8}" y="${n.y+38}" width="62" height="46" viewBox="0 0 190 140">${figInner(n.sh,'mini')}</svg>
      ${n.s.map((l,i)=>`<text class="sb" x="${n.x+78}" y="${n.y+(n.s.length===3?52:58)+i*15}">${l}</text>`).join('')}
    </g>`;
  });
  s+='</svg>';
  $('#treeBox').innerHTML=s;
  const open=g=>{if(!g)return;topic=g.dataset.t;kind='all';pos=0;reload();showTab('cards');window.scrollTo(0,0)};
  $('#treeBox').addEventListener('click',e=>open(e.target.closest('.node')));
  $('#treeBox').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open(e.target.closest('.node'))}});
})();

/* --- таблица --- */
(function(){
  const cols=[['para','Паралле&shy;лограмм','para'],['rect','Прямо&shy;угольник','rect'],['rhomb','Ромб','rhomb'],['sq','Квадрат','sq']];
  const rows=[
    ['Стороны'],
    ['Противоположные стороны параллельны',[1,1,1,1]],
    ['Противоположные стороны равны',[1,1,1,1]],
    ['Все стороны равны',[0,0,1,1]],
    ['Углы'],
    ['Противоположные углы равны',[1,1,1,1]],
    ['Соседние углы в сумме 180°',[1,1,1,1]],
    ['Все углы прямые',[0,1,0,1]],
    ['Диагонали'],
    ['Точкой пересечения делятся пополам',[1,1,1,1]],
    ['Равны',[0,1,0,1]],
    ['Перпендикулярны',[0,0,1,1]],
    ['Делят углы пополам',[0,0,1,1]]
  ];
  let h='<table><thead><tr><th scope="col"></th>'+cols.map(c=>`<th scope="col" style="--c:var(--${c[0]})"><svg class="fsv" viewBox="0 0 190 140" aria-hidden="true">${figInner(c[2],'mini')}</svg>${c[1]}</th>`).join('')+'</tr></thead><tbody>';
  let group='';
  rows.forEach(r=>{
    if(!r[1]){group=r[0];h+=`<tr class="grp"><th colspan="5" scope="colgroup">${r[0]}</th></tr>`;return}
    h+=`<tr><th scope="row">${r[0]}</th>`+r[1].map((v,i)=>`<td><button class="cell" data-v="${v}" data-s="${v?'✓':'✕'}" aria-label="${cols[i][1].replace(/&shy;/g,'')}: ${v?'да':'не обязательно'}"></button></td>`).join('')+'</tr>';
  });
  h+='</tbody></table>';
  const tw=$('#tw');tw.innerHTML=h;
  $('#quiz').addEventListener('click',e=>{
    const on=tw.classList.toggle('quiz');
    e.currentTarget.setAttribute('aria-pressed',String(on));
    e.currentTarget.textContent=on?'Показать всё':'Проверить себя';
    tw.querySelectorAll('.cell').forEach(c=>c.classList.remove('open'));
  });
  tw.addEventListener('click',e=>{const c=e.target.closest('.cell');if(c&&tw.classList.contains('quiz'))c.classList.toggle('open')});
  $('#rules').innerHTML=[
    ['para','Противоположное равно. Соседние углы в сумме 180°.'],
    ['rect','Прямоугольник: диагонали Равны. Ромб: диагонали Перпендикулярны.'],
    ['sq','Квадрат — прямоугольник и ромб сразу: ✓ в каждой строке.']
  ].map(r=>`<div class="note" style="--c:var(--${r[0]})">${r[1]}</div>`).join('');
})();

computeDeck();render();
})();
</script>
