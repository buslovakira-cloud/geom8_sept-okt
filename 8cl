<meta name="claude:viewport-fit-sides" content="cover">
<title>Четырёхугольники 8 класс</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Marck+Script&family=Onest:wght@400;500;600;700&family=Unbounded:wght@600;700&display=swap">
<style>
/* Концепт: тетрадный лист в клетку. У каждой фигуры свой цвет ручки; он ведёт её через карточки, дерево и таблицу. */
:root{
  --bg:#F3F5FB; --grid:#E1E7F4; --paper:#FFFFFF; --ink:#1A2138; --muted:#566080; --line:#CFD7EA; --soft:#EAEFFA;
  --quad:#56658A; --para:#2F6FDE; --trap:#C45F0B; --rect:#0E7F5C; --rhomb:#B8347F; --sq:#D43F36; --cmp:#7A5AC8;
  --on:#FFFFFF; --good:#0E7F5C; --again:#C45F0B;
  --f-display:'Unbounded','Onest',system-ui,sans-serif; --f-body:'Onest',system-ui,sans-serif; --f-hand:'Marck Script','Onest',cursive;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#11141E; --grid:#1A2030; --paper:#1A1F2E; --ink:#EDF0FA; --muted:#9AA4C2; --line:#2C3450; --soft:#232A3E;
    --quad:#9DAEDB; --para:#7BA3FF; --trap:#F5A05A; --rect:#45D3A2; --rhomb:#EE76B8; --sq:#FF8277; --cmp:#B49BFF;
    --on:#0F1220; --good:#45D3A2; --again:#F5A05A; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#11141E; --grid:#1A2030; --paper:#1A1F2E; --ink:#EDF0FA; --muted:#9AA4C2; --line:#2C3450; --soft:#232A3E;
  --quad:#9DAEDB; --para:#7BA3FF; --trap:#F5A05A; --rect:#45D3A2; --rhomb:#EE76B8; --sq:#FF8277; --cmp:#B49BFF;
  --on:#0F1220; --good:#45D3A2; --again:#F5A05A; color-scheme:dark;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  background-color:var(--bg);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:22px 22px; color:var(--ink); font:400 16px/1.5 var(--f-body);
  padding-block:18px 48px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--para);outline-offset:2px}
.wrap{max-width:640px;margin:0 auto;display:grid;gap:14px}
.stack{display:grid;gap:14px}
.eyebrow{margin:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
h1{margin:4px 0 0;font:700 clamp(21px,6.2vw,30px)/1.15 var(--f-display);overflow-wrap:anywhere}

.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px;background:var(--paper);border:1px solid var(--line);border-radius:14px}
.tabs button{border:0;background:transparent;padding:10px 6px;border-radius:10px;font:600 14px var(--f-body);color:var(--muted)}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--paper)}

.chips{display:flex;gap:8px;overflow-x:auto;padding:3px 3px 6px;margin-inline:-3px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:1.5px solid var(--c,var(--ink));background:var(--paper);color:var(--c,var(--ink));padding:7px 13px;border-radius:999px;font:600 13.5px var(--f-body);white-space:nowrap}
.chip[aria-pressed="true"]{background:var(--c,var(--ink));color:var(--on)}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{border:1px solid var(--line);background:var(--paper);padding:5px 11px;border-radius:8px;font:500 13px var(--f-body);color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--soft);border-color:var(--ink);color:var(--ink);font-weight:600}

.prog{display:grid;gap:6px}
.prog-row{display:flex;justify-content:space-between;gap:4px 12px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.prog-row b{color:var(--ink);font-variant-numeric:tabular-nums}
.bar{height:6px;border-radius:3px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--ink);transition:width .25s}

.scene{perspective:1400px}
.card{display:block;position:relative;border-radius:20px;cursor:pointer;-webkit-tap-highlight-color:transparent}
.flip{display:grid;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.3,.7,.2,1)}
.card.is-back .flip{transform:rotateY(180deg)}
.face{
  grid-area:1/1;backface-visibility:hidden;-webkit-backface-visibility:hidden;min-height:390px;
  background:var(--paper);border:1.5px solid var(--line);border-radius:20px;padding:16px 18px 18px;
  display:flex;flex-direction:column;gap:12px;box-shadow:0 14px 28px -20px rgba(20,30,70,.45);
}
.face.back{transform:rotateY(180deg);border-color:var(--c)}
.fh{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.tag{background:var(--c);color:var(--on);font:600 12px var(--f-body);letter-spacing:.04em;padding:4px 10px;border-radius:8px 8px 8px 2px}
.kind{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;display:flex;gap:8px;align-items:center}
.st{text-transform:none;letter-spacing:0;font-size:12px;padding:2px 7px;border-radius:6px;border:1px solid currentColor}
.st.k{color:var(--good)} .st.a{color:var(--again)}
.q{margin:0;font:600 20px/1.3 var(--f-body);text-wrap:balance}
.lab{margin:0;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--c)}
.fig{display:grid;place-items:center;flex:1;min-height:0}
.fig svg{width:100%;max-width:250px;height:auto}
.tip{margin:auto 0 0;font-size:12.5px;color:var(--muted);text-align:center}
.a{margin:0;font-size:17px;line-height:1.5}
.a ul{margin:0;padding-left:20px;display:grid;gap:6px}
.a b{color:var(--c)}
.note{font-family:var(--f-hand);font-size:22px;line-height:1.25;background:color-mix(in srgb,var(--c) 12%,var(--paper));border:1.5px dashed var(--c);border-radius:12px;padding:9px 14px 11px;color:var(--ink)}
.note small{display:block;font:700 11px var(--f-body);letter-spacing:.1em;text-transform:uppercase;color:var(--c);margin-bottom:2px}
.empty{padding:34px 20px;text-align:center;background:var(--paper);border:1.5px dashed var(--line);border-radius:18px;color:var(--muted);min-height:200px;display:grid;place-content:center;gap:6px}
.empty b{color:var(--ink);font-size:17px}

.ctl{display:grid;grid-template-columns:48px 1fr 1fr 48px;gap:8px}
.ctl button{min-height:50px;border-radius:14px;border:1.5px solid var(--line);background:var(--paper);font:600 15px var(--f-body)}
.ctl button:disabled{opacity:.4;cursor:default}
.ctl .nav{font-size:20px}
.ctl .again{border-color:var(--again);color:var(--again)}
.ctl .know{background:var(--good);border-color:var(--good);color:var(--on)}
.row2{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.link{background:none;border:0;color:var(--muted);font-size:13px;text-decoration:underline;text-underline-offset:3px;padding:6px}

.panel{background:var(--paper);border:1.5px solid var(--line);border-radius:18px;padding:14px}
.lead{margin:0 0 8px;color:var(--muted);font-size:14px}
.tree svg.t{width:100%;height:auto;display:block}
.node{cursor:pointer}
.node rect.nb{fill:var(--paper);stroke:var(--c);stroke-width:2}
.node:hover rect.nb,.node:focus-visible rect.nb{fill:color-mix(in srgb,var(--c) 10%,var(--paper))}
.node:focus-visible{outline:none}
.node:focus-visible rect.nb{stroke-width:3.5}
.node text{font-family:var(--f-body)}
.node .nm{font-weight:700;font-size:13.5px;fill:var(--c)}
.node .sb{font-size:11.5px;fill:var(--muted)}
.edge{fill:none;stroke:var(--muted);stroke-width:1.8}
.lore{display:grid;gap:10px;margin:14px 0 0;padding:0;list-style:none;font-size:15px}
.lore b{color:var(--ink)}

.tools{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.legend{font-size:13px;color:var(--muted)}
.tw{overflow-x:auto;border:1.5px solid var(--line);border-radius:14px;background:var(--paper)}
table{border-collapse:separate;border-spacing:0;min-width:540px;width:100%;font-size:14px}
th,td{padding:8px 6px;border-bottom:1px solid var(--line);text-align:center}
tbody tr:last-child td{border-bottom:0}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:var(--paper);min-width:150px;padding-left:12px;z-index:1}
thead th{vertical-align:bottom;color:var(--c);font:700 12px/1.2 var(--f-body)}
thead th svg{display:block;margin:0 auto 4px;width:54px;height:auto}
tr.grp th{background:var(--soft);text-align:left;font:700 11px var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:6px 12px}
tbody th{font-weight:500;text-align:left}
.cell{border:0;background:none;width:36px;height:36px;border-radius:9px;font:700 18px var(--f-body)}
.cell::after{content:attr(data-s)}
.cell[data-v="1"]{color:var(--good)}
.cell[data-v="0"]{color:var(--muted);font-weight:500}
.quiz .cell:not(.open){background:var(--soft);color:var(--muted);font-weight:600}
.quiz .cell:not(.open)::after{content:"?"}

/* чертежи */
.fsv .body{fill:color-mix(in srgb,var(--c) 14%,transparent);stroke:var(--c);stroke-width:2.6;stroke-linejoin:round}
.fsv .sh2{fill:color-mix(in srgb,var(--c) 32%,transparent);stroke:none}
.fsv .mk{fill:none;stroke:var(--ink);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.fsv .dg{fill:none;stroke:var(--muted);stroke-width:1.6;stroke-dasharray:5 4}
.fsv .dg2{fill:none;stroke:var(--c);stroke-width:3;stroke-linecap:round}
.fsv .lt{fill:var(--ink);font:600 12px var(--f-body)}
.fsv .dot{fill:var(--ink)}

@media (prefers-reduced-motion:reduce){.flip,.bar i{transition:none}}
@media (max-width:380px){.q{font-size:18.5px}.a{font-size:16px}.note{font-size:20px}}
</style>
<div class="wrap">
  <header>
    <p class="eyebrow">Геометрия · 8 класс · 1 четверть</p>
    <h1>Четырёхугольники</h1>
  </header>

  <nav class="tabs" role="tablist" aria-label="Режим">
    <button role="tab" id="t-cards" aria-selected="true" aria-controls="v-cards">Карточки</button>
    <button role="tab" id="t-tree" aria-selected="false" aria-controls="v-tree" tabindex="-1">Дерево</button>
    <button role="tab" id="t-table" aria-selected="false" aria-controls="v-table" tabindex="-1">Таблица</button>
  </nav>

  <main>
    <section id="v-cards" role="tabpanel" aria-labelledby="t-cards" class="stack">
      <div class="chips" id="topics" role="group" aria-label="Тема"></div>
      <div class="seg" id="kinds" role="group" aria-label="Тип карточек"></div>
      <div class="prog">
        <div class="prog-row"><span id="pos"></span><span id="cnt"></span></div>
        <div class="bar" id="bar"><i></i></div>
      </div>
      <div class="scene" id="scene"></div>
      <div class="ctl">
        <button class="nav" id="prev" aria-label="Предыдущая карточка">←</button>
        <button class="again" id="again">Повторить</button>
        <button class="know" id="know">Знаю</button>
        <button class="nav" id="next" aria-label="Следующая карточка">→</button>
      </div>
      <div class="row2">
        <button class="link" id="shuf">Перемешать</button>
        <button class="link" id="reset">Сбросить отметки</button>
      </div>
    </section>

    <section id="v-tree" role="tabpanel" aria-labelledby="t-tree" class="stack" hidden>
      <div class="panel tree">
        <p class="lead">Нажми на фигуру, чтобы открыть её карточки.</p>
        <div id="treeBox"></div>
        <ul class="lore">
          <li><b>Дети знают всё, что умеют родители.</b> Прямоугольник и ромб получают все свойства параллелограмма и добавляют своё.</li>
          <li><b>Квадрат — наследник обоих.</b> Поэтому у него есть все свойства сразу.</li>
          <li><b>Трапеция живёт отдельно.</b> У неё только одна пара параллельных сторон, поэтому параллелограмм её не родитель.</li>
        </ul>
      </div>
    </section>

    <section id="v-table" role="tabpanel" aria-labelledby="t-table" class="stack" hidden>
      <div class="tools">
        <button class="chip" id="quiz" aria-pressed="false">Проверить себя</button>
        <span class="legend">✓ всегда · ✕ не обязательно</span>
      </div>
      <div class="tw" id="tw"></div>
      <div class="stack" id="rules"></div>
    </section>
  </main>
</div>

<script>
/* ===== Чертежи ===== */
const SH={
  quad:[[28,104],[46,34],[150,22],[168,112]],
  para:[[22,112],[58,34],[168,34],[132,112]],
  trap:[[16,112],[56,34],[128,34],[176,112]],
  trapIso:[[20,112],[60,34],[130,34],[170,112]],
  trapRight:[[22,112],[22,34],[122,34],[176,112]],
  rect:[[24,112],[24,36],[166,36],[166,112]],
  rhomb:[[26,114],[71,36],[161,36],[116,114]],
  sq:[[52,116],[52,32],[138,32],[138,116]]
};
const PAR={para:[[0,2],[1,3]],rect:[[0,2],[1,3]],rhomb:[[0,2],[1,3]],sq:[[0,2],[1,3]],trap:[[1,3]],trapIso:[[1,3]],trapRight:[[1,3]]};
const EQ={para:[1,2,1,2],rect:[1,2,1,2],rhomb:[1,1,1,1],sq:[1,1,1,1],trapIso:[1,0,1,0]};
const ANG={para:[1,2,1,2],rhomb:[1,2,1,2],trapIso:[1,2,2,1]};
const RT={rect:[0,1,2,3],sq:[0,1,2,3],trapRight:[0,1]};

const f1=n=>Math.round(n*10)/10;
const P=a=>f1(a[0])+','+f1(a[1]);
const vsub=(a,b)=>[a[0]-b[0],a[1]-b[1]];
const vadd=(a,b)=>[a[0]+b[0],a[1]+b[1]];
const vmul=(a,k)=>[a[0]*k,a[1]*k];
const vmid=(a,b)=>[(a[0]+b[0])/2,(a[1]+b[1])/2];
const vun=a=>{const l=Math.hypot(a[0],a[1])||1;return [a[0]/l,a[1]/l]};
const seg=(a,b,cls)=>`<line class="${cls||'mk'}" x1="${f1(a[0])}" y1="${f1(a[1])}" x2="${f1(b[0])}" y2="${f1(b[1])}"/>`;
const poly=(pts,cls)=>`<polyline class="${cls||'mk'}" points="${pts.map(P).join(' ')}"/>`;

function ticks(a,b,n){
  if(!n)return '';
  const m=vmid(a,b),u=vun(vsub(b,a)),nv=[-u[1],u[0]];
  let s='';
  for(let i=0;i<n;i++){
    const c=vadd(m,vmul(u,(i-(n-1)/2)*5));
    s+=seg(vadd(c,vmul(nv,5)),vsub(c,vmul(nv,5)));
  }
  return s;
}
function arrows(a,b,n){
  const m=vmid(a,b),u=vun(vsub(b,a)),nv=[-u[1],u[0]];
  let s='';
  for(let i=0;i<n;i++){
    const c=vadd(m,vmul(u,(i-(n-1)/2)*6));
    const back=vsub(c,vmul(u,3));
    s+=poly([vadd(back,vmul(nv,4.5)),vadd(c,vmul(u,3)),vsub(back,vmul(nv,4.5))]);
  }
  return s;
}
function rightAt(Q,A,B,s){
  s=s||9;
  const a=vun(vsub(A,Q)),b=vun(vsub(B,Q));
  const pa=vadd(Q,vmul(a,s)),pb=vadd(Q,vmul(b,s));
  return poly([pa,vadd(pa,vmul(b,s)),pb]);
}
function arcAt(Q,A,B,r){
  const u=vun(vsub(A,Q)),v=vun(vsub(B,Q));
  const sw=(u[0]*v[1]-u[1]*v[0])>0?1:0;
  const a=vadd(Q,vmul(u,r)),b=vadd(Q,vmul(v,r));
  return `<path class="mk" d="M${P(a)} A${r},${r} 0 0 ${sw} ${P(b)}"/>`;
}
function angArcs(p,i,n){
  let s='';
  for(let k=0;k<n;k++)s+=arcAt(p[i],p[(i+3)%4],p[(i+1)%4],13+k*4.5);
  return s;
}
function inter(a,b,c,d){
  const x1=a[0],y1=a[1],x2=b[0],y2=b[1],x3=c[0],y3=c[1],x4=d[0],y4=d[1];
  const t=((x1-x3)*(y3-y4)-(y1-y3)*(x3-x4))/((x1-x2)*(y3-y4)-(y1-y2)*(x3-x4));
  return [x1+t*(x2-x1),y1+t*(y2-y1)];
}
function lbl(t,pt,c,dist){
  const d=vun(vsub(pt,c)),q=vadd(pt,vmul(d,dist||11));
  return `<text class="lt" x="${f1(q[0])}" y="${f1(q[1]+4.5)}" text-anchor="middle">${t}</text>`;
}

/* Флаги: par ∥-стрелки · eq штрихи равных сторон · rt прямые углы · ang равные углы · tri два треугольника
   diag диагонали · mid штрихи на половинках · perp ⊥ в точке O · bis диагонали-биссектрисы
   eqd выделить диагонали · ml средняя линия · mini без букв (для дерева и таблицы) */
function figInner(shape,flags){
  const F=new Set((flags||'').split(' ').filter(Boolean));
  const mini=F.has('mini'),p=SH[shape];
  const c=[p.reduce((s,q)=>s+q[0],0)/4,p.reduce((s,q)=>s+q[1],0)/4];
  let s=`<polygon class="body" points="${p.map(P).join(' ')}"/>`;
  if(F.has('tri'))s+=`<polygon class="sh2" points="${[p[0],p[1],p[2]].map(P).join(' ')}"/>`+seg(p[0],p[2],'dg2');
  if(F.has('par'))(PAR[shape]||[]).forEach((pr,k)=>{
    s+=arrows(p[pr[0]],p[(pr[0]+1)%4],k+1)+arrows(p[(pr[1]+1)%4],p[pr[1]],k+1);
  });
  if(F.has('eq')&&EQ[shape])EQ[shape].forEach((n,i)=>{s+=ticks(p[i],p[(i+1)%4],n)});
  if(F.has('rt')&&RT[shape])RT[shape].forEach(i=>{s+=rightAt(p[i],p[(i+3)%4],p[(i+1)%4])});
  if(F.has('ang')&&ANG[shape])ANG[shape].forEach((n,i)=>{s+=angArcs(p,i,n)});
  if(F.has('diag')){
    const O=inter(p[0],p[2],p[1],p[3]),dc=F.has('eqd')?'dg2':'dg';
    s+=seg(p[0],p[2],dc)+seg(p[1],p[3],dc);
    if(F.has('mid')){
      const two=(shape==='rect'||shape==='sq')?1:2;
      s+=ticks(p[0],O,1)+ticks(O,p[2],1)+ticks(p[1],O,two)+ticks(O,p[3],two);
    }
    if(F.has('perp'))s+=rightAt(O,p[1],p[2],8);
    if(F.has('bis'))for(let i=0;i<4;i++){
      const T=p[(i+2)%4];
      s+=arcAt(p[i],p[(i+3)%4],T,15)+arcAt(p[i],T,p[(i+1)%4],15);
    }
    if(!mini)s+=`<circle class="dot" cx="${f1(O[0])}" cy="${f1(O[1])}" r="2.6"/><text class="lt" x="${f1(O[0]+8)}" y="${f1(O[1]-6)}" text-anchor="middle">O</text>`;
  }
  if(F.has('ml')){
    const M=vmid(p[0],p[1]),N=vmid(p[2],p[3]);
    s+=seg(M,N,'dg2')+ticks(p[0],M,1)+ticks(M,p[1],1)+ticks(p[2],N,2)+ticks(N,p[3],2);
    if(!mini)s+=`<text class="lt" x="${f1(M[0]-11)}" y="${f1(M[1]+4.5)}" text-anchor="middle">M</text><text class="lt" x="${f1(N[0]+11)}" y="${f1(N[1]+4.5)}" text-anchor="middle">N</text>`;
  }
  if(!mini)['A','B','C','D'].forEach((t,i)=>{s+=lbl(t,p[i],c)});
  return s;
}
const fig=(shape,flags,label)=>`<svg class="fsv" viewBox="0 0 190 140" role="img" aria-label="${label||'Чертёж фигуры'}">${figInner(shape,flags)}</svg>`;
/* ===== Карточки ===== */
const TOPICS=[
  {id:'quad',name:'Четырёхугольник',c:'--quad'},
  {id:'para',name:'Параллелограмм',c:'--para'},
  {id:'trap',name:'Трапеция',c:'--trap'},
  {id:'rect',name:'Прямоугольник',c:'--rect'},
  {id:'rhomb',name:'Ромб',c:'--rhomb'},
  {id:'sq',name:'Квадрат',c:'--sq'},
